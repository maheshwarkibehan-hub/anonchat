{
  "name": "anon-chat",
  "version": "2.0.0",
  "description": "100% Free, minimalist, anonymous 1-on-1 random chat web app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test_suite.js",
    "maintenance:on": "node -e \"require('fs').writeFileSync('.maintenance', 'true'); console.log('>>> Maintenance Mode: ENABLED')\"",
    "maintenance:off": "node -e \"try{require('fs').unlinkSync('.maintenance')}catch(e){}; console.log('>>> Maintenance Mode: DISABLED')\"",
    "maintenance:status": "node -e \"console.log(require('fs').existsSync('.maintenance') ? 'STATUS: Maintenance is ACTIVE' : 'STATUS: App is LIVE')\""
  },
  "keywords": ["chat", "anonymous", "omegle-clone", "socketio", "realtime"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  }
}
